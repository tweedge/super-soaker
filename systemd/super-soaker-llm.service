[Unit]
Description=super-soaker 2/3 LLM: llama.cpp LFM2.5 (profile from /etc/super-soaker/llm.env) (HTTP tcp/8080)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=super-soaker
Group=super-soaker
EnvironmentFile=-/etc/super-soaker/llm.env
ExecStart=/opt/super-soaker/services/2-llm-llama.cpp-super-soaker-managed/serve.sh
Restart=always
RestartSec=5
MemorySwapMax=0
LimitMEMLOCK=infinity
Nice=-5

[Install]
WantedBy=multi-user.target