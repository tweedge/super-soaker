{
  "_comment": "Home Assistant voice-assistant benchmark battery. Mirrors the tool surface the HA Assist LLM API exposes (HassTurnOn, HassLightSet, timers, lists, climate, media, weather, math) and the utterance classes seen in community wishlists (timers, lights, weather, shopping list, media, climate, room context, no-action small talk). Edit freely; the runner is model-agnostic.",
  "chat_system": "You are 'Assist', a Home Assistant voice assistant. Keep spoken answers short (1-3 sentences) unless asked otherwise.",
  "latency_prompt_system": "You are 'Assist', a Home Assistant voice assistant. Keep spoken answers short (1-3 sentences). Use the provided tools to control the home.",
  "latency_utterance": "Turn on the kitchen lights, then tell me the outdoor temperature in one short sentence.",
  "tool_system": "Current time is 2026-10-12 14:00 UTC. You are 'Assist', a Home Assistant voice assistant for the home of tweedge. Available areas: kitchen, living room, bedroom, office, garage. Keep spoken answers short. When the user wants to control or query the home, use the matching tool. If the request is not about the home, just answer normally.",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "HassTurnOn",
        "description": "Turns on a device or entity",
        "parameters": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Device or entity name"
            },
            "area": {
              "type": "string",
              "description": "Area (room) name"
            }
          },
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "HassTurnOff",
        "description": "Turns off a device or entity",
        "parameters": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "area": {
              "type": "string"
            }
          },
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "HassLightSet",
        "description": "Sets brightness or color of a light",
        "parameters": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "area": {
              "type": "string"
            },
            "brightness": {
              "type": "integer",
              "description": "0-255"
            },
            "color": {
              "type": "string"
            }
          },
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "HassClimateSetTemperature",
        "description": "Sets the thermostat target temperature",
        "parameters": {
          "type": "object",
          "properties": {
            "area": {
              "type": "string"
            },
            "temperature": {
              "type": "number"
            }
          },
          "required": [
            "temperature"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "HassClimateGetTemperature",
        "description": "Gets the current thermostat temperature",
        "parameters": {
          "type": "object",
          "properties": {
            "area": {
              "type": "string"
            }
          },
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "HassStartTimer",
        "description": "Starts a countdown timer",
        "parameters": {
          "type": "object",
          "properties": {
            "duration": {
              "type": "string",
              "description": "e.g. '10 minutes' or '00:10:00'"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "duration"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "HassCancelTimer",
        "description": "Cancels a timer",
        "parameters": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "area": {
              "type": "string"
            }
          },
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "HassListAddItem",
        "description": "Adds an item to a list (e.g. shopping list)",
        "parameters": {
          "type": "object",
          "properties": {
            "item": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "description": "list name, defaults to shopping list"
            }
          },
          "required": [
            "item"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "HassMediaPause",
        "description": "Pauses media playback",
        "parameters": {
          "type": "object",
          "properties": {
            "area": {
              "type": "string"
            }
          },
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "HassMediaUnpause",
        "description": "Resumes media playback",
        "parameters": {
          "type": "object",
          "properties": {
            "area": {
              "type": "string"
            }
          },
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "HassMediaNext",
        "description": "Skips to the next track",
        "parameters": {
          "type": "object",
          "properties": {
            "area": {
              "type": "string"
            }
          },
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "HassMediaVolumeSet",
        "description": "Sets media player volume",
        "parameters": {
          "type": "object",
          "properties": {
            "volume_level": {
              "type": "number",
              "description": "0.0-1.0"
            },
            "area": {
              "type": "string"
            }
          },
          "required": [
            "volume_level"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_state",
        "description": "Gets the state of an entity",
        "parameters": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "weather_get_forecasts",
        "description": "Gets the weather forecast",
        "parameters": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string"
            },
            "type_of_forecast": {
              "type": "string",
              "description": "daily, hourly, minutely"
            }
          },
          "required": [
            "location"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "calculate_math",
        "description": "Calculates a math expression",
        "parameters": {
          "type": "object",
          "properties": {
            "expression": {
              "type": "string"
            }
          },
          "required": [
            "expression"
          ]
        }
      }
    }
  ],
  "quality_scenarios": [
    {
      "id": "capital_france",
      "max_words": 12,
      "require_any": [
        "paris"
      ],
      "utterance": "What is the capital of France?"
    },
    {
      "id": "leap_year",
      "max_words": 12,
      "require_any": [
        "366"
      ],
      "utterance": "How many days are in a leap year?"
    },
    {
      "id": "romeo",
      "max_words": 14,
      "require_any": [
        "shakespeare"
      ],
      "utterance": "Who wrote Romeo and Juliet?"
    },
    {
      "id": "arithmetic",
      "max_words": 6,
      "require_any": [
        "4140"
      ],
      "utterance": "What is 345 times 12? Answer with just the number."
    },
    {
      "id": "ocean",
      "max_words": 10,
      "require_any": [
        "pacific"
      ],
      "utterance": "What is the largest ocean on Earth?"
    },
    {
      "id": "boiling",
      "max_words": 12,
      "require_any": [
        "100"
      ],
      "utterance": "At what temperature does water boil in Celsius?"
    },
    {
      "id": "prime",
      "max_words": 8,
      "require_any": [
        "yes"
      ],
      "forbid_any": [
        "no,"
      ],
      "utterance": "Is 97 a prime number? Answer yes or no."
    },
    {
      "id": "count_r",
      "_comment": "classic tokenizer failure test",
      "max_words": 5,
      "require_any": [
        "3"
      ],
      "utterance": "How many letter r are in the word strawberry? Answer with just a number."
    },
    {
      "id": "joke_brief",
      "_comment": "brevity for voice",
      "max_words": 45,
      "require_any": [],
      "utterance": "Tell me a one sentence joke about smart homes."
    },
    {
      "id": "refuse_weather",
      "_comment": "should hedge, not fabricate",
      "max_words": 60,
      "require_any": [],
      "utterance": "What will the weather be like on Mars next Tuesday, exactly?"
    }
  ],
  "tool_scenarios": [
    {
      "id": "light_on_room",
      "utterance": "Turn on the kitchen lights",
      "expect": {
        "tool": "HassTurnOn",
        "args": {
          "area": "kitchen"
        }
      }
    },
    {
      "id": "light_off_named",
      "utterance": "Turn off the desk lamp",
      "expect": {
        "tool": "HassTurnOff",
        "args_any": {
          "by_name": {
            "name": "desk"
          }
        }
      }
    },
    {
      "id": "light_dim",
      "utterance": "Dim the living room lights to 40 percent",
      "expect": {
        "tool": "HassLightSet",
        "args_any": {
          "by_area": {
            "area": "living"
          }
        },
        "args_check": "brightness_40_or_102"
      }
    },
    {
      "id": "light_color",
      "utterance": "Set the bedroom lights to red",
      "expect": {
        "tool": "HassLightSet",
        "args_any": {
          "by_area": {
            "area": "bedroom"
          }
        },
        "args": {
          "color": "red"
        }
      }
    },
    {
      "id": "timer_set",
      "utterance": "Set a timer for 10 minutes",
      "expect": {
        "tool": "HassStartTimer",
        "args_check": "duration_10_minutes"
      }
    },
    {
      "id": "timer_cancel",
      "utterance": "Cancel the pasta timer",
      "expect": {
        "tool": "HassCancelTimer",
        "args_any": {
          "by_name": {
            "name": "pasta"
          }
        }
      }
    },
    {
      "id": "list_add",
      "utterance": "Add milk to the shopping list",
      "expect": {
        "tool": "HassListAddItem",
        "args": {
          "item": "milk"
        }
      }
    },
    {
      "id": "climate_set",
      "utterance": "Set the thermostat to 72 degrees",
      "expect": {
        "tool": "HassClimateSetTemperature",
        "args": {
          "temperature": 72
        }
      }
    },
    {
      "id": "climate_get",
      "utterance": "What is the temperature in the bedroom?",
      "expect": {
        "tool": "HassClimateGetTemperature",
        "args_any": {
          "by_area": {
            "area": "bedroom"
          },
          "by_name": {
            "name": "bedroom"
          }
        }
      }
    },
    {
      "id": "media_pause",
      "utterance": "Pause the music",
      "expect": {
        "tool": "HassMediaPause"
      }
    },
    {
      "id": "media_next",
      "utterance": "Skip to the next song",
      "expect": {
        "tool": "HassMediaNext"
      }
    },
    {
      "id": "media_volume",
      "utterance": "Set the volume to 50 percent",
      "expect": {
        "tool": "HassMediaVolumeSet",
        "args_check": "volume_0_5"
      }
    },
    {
      "id": "weather",
      "utterance": "Will it rain tomorrow?",
      "expect": {
        "tool": "weather_get_forecasts"
      }
    },
    {
      "id": "state_query",
      "utterance": "Is the front door locked?",
      "expect": {
        "tool": "get_state",
        "args_any": {
          "by_name": {
            "name": "front"
          }
        }
      }
    },
    {
      "id": "area_all_off",
      "utterance": "Turn off everything in the office",
      "expect": {
        "tool": "HassTurnOff",
        "args": {
          "area": "office"
        }
      }
    },
    {
      "id": "math_tool",
      "utterance": "What is 345 times 12?",
      "expect": {
        "tool": "calculate_math",
        "args_check": "expr_has_345_and_12"
      }
    },
    {
      "id": "implicit_climate",
      "_comment": "implicit intent: no explicit number; model must raise the setpoint",
      "utterance": "It is cold in here, warm it up a bit",
      "expect": {
        "tool": [
          "HassClimateSetTemperature",
          "HassClimateGetTemperature"
        ],
        "args_check": "temp_up_68_80",
        "_note": "either set directly, or check first then set"
      }
    },
    {
      "id": "no_tool_bye",
      "_comment": "must NOT call a tool",
      "utterance": "Thanks, that is all. Goodbye!",
      "expect": {
        "tool": null
      }
    },
    {
      "id": "no_tool_chitchat",
      "utterance": "Tell me a two sentence story about a robot.",
      "expect": {
        "tool": null
      }
    },
    {
      "id": "no_tool_nonsense",
      "_comment": "nonsense: must not hallucinate a device action",
      "utterance": "Flurble wibble the gronkus plaz.",
      "expect": {
        "tool": null
      }
    }
  ]
}